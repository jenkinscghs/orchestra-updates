#!/data/data/com.termux/files/usr/bin/bash
cd "$HOME/.ssh/orchestra-updates"

# Fail on error
set -e

# Require a message
if [ "$#" -eq 0 ]; then
  echo "Usage: post Your message here [| image_url]"
  exit 1
fi

# Raw input
RAW="$*"

# Split body and optional image URL
if [[ "$RAW" == *"|"* ]]; then
  BODY="${RAW%%|*}"
  IMAGE="${RAW#*|}"
  BODY="$(echo "$BODY" | xargs)"
  IMAGE="$(echo "$IMAGE" | xargs)"
else
  BODY="$RAW"
  IMAGE=""
fi

# Timestamp
TS=$(date -Iseconds)

# Append JSON entry using Python (safe + clean)
python - <<EOF
import json, os

fname = "feed.json"

if os.path.exists(fname):
    with open(fname) as f:
        data = json.load(f)
else:
    data = []

entry = {
    "ts": "$TS",
    "body": "$BODY"
}

if "$IMAGE":
    entry["image"] = "$IMAGE"

data.append(entry)

with open(fname, "w") as f:
    json.dump(data, f, indent=2)
EOF

# Commit and push
git add feed.json
git commit -m "Post: $BODY"
git push

echo "✅ Posted successfully"
